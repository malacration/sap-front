FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
ENV NG_CLI_ANALYTICS=false

# O summernote e uma dependencia local do package.json.
COPY package.json package-lock.json ./
COPY summernote ./summernote
# Build web: nao precisa baixar Electron nem executar seus scripts de instalacao.
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts --no-audit --no-fund && \
    npm rebuild admin-lte --no-audit --no-fund
FROM dependencies AS dev
COPY . .
EXPOSE 80
CMD ["npx", "ng", "serve", "--configuration", "web", "--host", "0.0.0.0", "--port", "80", "--poll", "1000", "--proxy-config", "/proxy.conf.json"]

