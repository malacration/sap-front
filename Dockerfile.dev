# syntax=docker/dockerfile:1
FROM node:26.13.0-bookworm-slim AS dependencies
WORKDIR /app
ENV NG_CLI_ANALYTICS=false
COPY package.json package-lock.json ./
COPY summernote ./summernote
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts --no-audit --no-fund && \
    npm rebuild admin-lte esbuild --no-audit --no-fund

FROM dependencies AS dev
COPY . .
EXPOSE 80
CMD ["sh", "-c", "npm ci --ignore-scripts --no-audit --no-fund && npm rebuild admin-lte esbuild --no-audit --no-fund && exec ./node_modules/.bin/ng serve --configuration web --host 0.0.0.0 --port 80 --poll 1000 --proxy-config /proxy.conf.json"]
